{
  "name": "card-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Business card scanner: images in, verified spreadsheet rows out.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build:web && node src/server/index.ts",
    "dev:server": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.16",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.15",
    "openai": "^7.52.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
